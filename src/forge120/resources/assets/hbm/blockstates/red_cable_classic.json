{
  "multipart": [
    { "apply": { "model": "hbm:block/red_cable_classic_core" } },
    { "when": { "north": "true" }, "apply": { "model": "hbm:block/red_cable_classic_arm" } },
    { "when": { "south": "true" }, "apply": { "model": "hbm:block/red_cable_classic_arm", "y": 180 } },
    { "when": { "east": "true" }, "apply": { "model": "hbm:block/red_cable_classic_arm", "y": 90 } },
    { "when": { "west": "true" }, "apply": { "model": "hbm:block/red_cable_classic_arm", "y": 270 } },
    { "when": { "up": "true" }, "apply": { "model": "hbm:block/red_cable_classic_arm", "x": 90 } },
    { "when": { "down": "true" }, "apply": { "model": "hbm:block/red_cable_classic_arm", "x": 270 } }
  ]
}
